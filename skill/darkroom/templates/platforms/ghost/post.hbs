{{!< default}}
{{#post}}
<article class="section {{post_class}}">
  <div class="wrap">
    <h1>{{title}}</h1>
    <p><time datetime="{{date format="YYYY-MM-DD"}}">{{date}}</time></p>
    {{#if feature_image}}<img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">{{/if}}
    <div class="gh-content">{{content}}</div>
  </div>
</article>
{{/post}}
