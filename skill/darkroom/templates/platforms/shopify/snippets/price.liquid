{%- comment -%} Renders a variant's price. Usage: {% render 'price', variant: product.selected_or_first_available_variant %} {%- endcomment -%}
<p class="price">
  {%- if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s> {% endif -%}
  {{ variant.price | money }}
</p>
